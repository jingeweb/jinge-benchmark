{
  "name": "jinge-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs && node scripts/verify.mjs",
    "bench": "node scripts/run.mjs && node scripts/extended.mjs",
    "report": "node scripts/analyze-traces.mjs && node scripts/report.mjs && oxfmt README.md",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.vue.json",
    "bench:extended": "node scripts/extended.mjs",
    "heap": "node scripts/heap.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:results": "node scripts/check-results.mjs"
  },
  "dependencies": {
    "jinge": "4.2.1",
    "jinge-router": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "jinge-compiler": "4.2.1",
    "oxfmt": "0.76.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
