{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src/shared/**/*.ts", "src/jinge/**/*.tsx", "src/jinge-gestures/**/*.tsx"]
}
